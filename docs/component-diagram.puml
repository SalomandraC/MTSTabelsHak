@startuml WikiLive_Component_Diagram
title WikiLive - Component Diagram (Updated)

skinparam componentStyle rectangle
skinparam shadowing false
skinparam wrapWidth 220
skinparam maxMessageSize 160
skinparam packageStyle rectangle
skinparam defaultTextAlignment center

actor "User" as User

package "Browser / Frontend\nReact + Vite + Tiptap" as Frontend {
  [Workspace App\nMWS-first tree, page navigation] as FE_Workspace
  [Auth Gate + Session Store\naccess token in memory] as FE_Auth
  [WikiLive API Client\nREST adapter] as FE_ApiClient
  [Editor Orchestrator\nstate + autosave + modals] as FE_Editor
  [Tiptap Core + Extensions\nslash, links, comments,\nembeds, templates, formulas] as FE_Tiptap
  [MWS Table Embed UI\nlive grid, picker, actions] as FE_MwsEmbed
  [AI Sidebar / Inline Copilot] as FE_Ai
  [Plugins + Templates UI] as FE_PluginsTemplates
  [Graph / Backlinks Panel] as FE_Graph
  database "Browser Local Storage\nlocal drafts, preferences,\nview options" as BrowserStorage
  [Hocuspocus Provider\nYjs WebSocket client] as FE_CollabProvider
}

package "Backend / WikiLive API\nNestJS" as Backend {
  [Auth API\nlogin/refresh/logout/me] as BE_Auth
  [Pages + Access API\nCRUD, page access policy] as BE_Pages
  [Wiki Tree / Workspace API\nfolders, move node, MWS-first tree] as BE_Tree
  [Links API\nbacklinks/outgoing links] as BE_Links
  [Comments API\nthreads + messages] as BE_Comments
  [Collab API\nsession bootstrap, checkpoints] as BE_CollabApi
  [History API\ncheckpoints list/get] as BE_History
  [Plugins API\ncatalog, activation, settings] as BE_Plugins
  [Templates API\nCRUD + instantiate] as BE_Templates
  [Search API\ncontext search endpoint] as BE_Search
  [AI API\nchat, autocomplete, transform,\ntool execution, planning] as BE_Ai
  [MWS BFF Adapter\nspaces, nodes, datasheets,\nfields, views, records, attachments,\nresolve embed, table pages] as BE_Mws
  [Hocuspocus WS Server\npresence + CRDT transport] as BE_Hocuspocus
  [Collab Persistence\nYjs updates, snapshots, checkpoints] as BE_CollabPersistence
  [Indexing Worker\nlink/embed extraction,\ncontext indexing jobs] as BE_Indexing
  [Export Gateway\nproxy to document-generator] as BE_Export
  [Prisma ORM] as BE_Prisma
}

package "Services" as Services {
  [Context Engine\nFastAPI semantic search\n/index/documents, /search] as S_Context
  [Document Generator\nExpress /generate\nPDF, DOCX, MD] as S_DocGen
}

package "Infrastructure" as Infra {
  database "PostgreSQL\nwiki_nodes, wiki_pages,\npage_documents, crdt_updates,\ncheckpoints, links, comments,\ntemplates, plugin states" as Postgres
  database "Redis\ncache + queue backend" as Redis
  queue "BullMQ\nmaintenance/indexing jobs" as BullMQ
}

cloud "MWS Tables API\nhttps://tables.mws.ru/fusion/v1/" as MwsApi
cloud "MWS GPT API" as MwsGptApi

User --> FE_Workspace : uses app
FE_Workspace --> FE_Auth
FE_Workspace --> FE_ApiClient
FE_Workspace --> FE_Editor

FE_Editor --> FE_Tiptap
FE_Editor --> FE_MwsEmbed
FE_Editor --> FE_Ai
FE_Editor --> FE_PluginsTemplates
FE_Editor --> FE_Graph
FE_Editor --> BrowserStorage : local autosave + recovery
FE_Editor --> FE_CollabProvider : bind Y.Doc

FE_ApiClient --> BE_Auth
FE_ApiClient --> BE_Pages
FE_ApiClient --> BE_Tree
FE_ApiClient --> BE_Links
FE_ApiClient --> BE_Comments
FE_ApiClient --> BE_CollabApi
FE_ApiClient --> BE_History
FE_ApiClient --> BE_Plugins
FE_ApiClient --> BE_Templates
FE_ApiClient --> BE_Search
FE_ApiClient --> BE_Ai
FE_ApiClient --> BE_Mws
FE_ApiClient --> BE_Export
FE_CollabProvider --> BE_Hocuspocus : WebSocket Yjs updates

BE_Auth --> BE_Mws : validate API key by MWS spaces
BE_Pages --> BE_Prisma
BE_Tree --> BE_Prisma
BE_Links --> BE_Prisma
BE_Comments --> BE_Prisma
BE_History --> BE_Prisma
BE_Plugins --> BE_Prisma
BE_Templates --> BE_Prisma

BE_CollabApi --> BE_CollabPersistence
BE_Hocuspocus --> BE_CollabPersistence
BE_CollabApi --> BE_Prisma : sessions bootstrap

BE_CollabPersistence --> BullMQ : enqueue indexing/maintenance
BE_Indexing --> BullMQ
BE_Indexing --> S_Context : index/delete document chunks
BE_Search --> S_Context : semantic search request
BE_Ai --> S_Context : retrieval context
BE_Ai --> MwsGptApi : inference requests

BE_Mws --> Redis : read-through cache
BE_Mws --> MwsApi : upstream REST calls

BE_Export --> S_DocGen : /generate

BE_Prisma --> Postgres
BE_CollabPersistence --> BE_Prisma
BE_Indexing --> BE_Prisma
BullMQ --> Redis

note right of FE_MwsEmbed
  mwsTableEmbed stores identity + config,
  not full table snapshot.
  Data is fetched live via backend BFF.
end note

note bottom of S_Context
  Qdrant persistent vector index,
  filtered by space for retrieval safety.
end note

note bottom of BE_CollabPersistence
  Collaboration is verifiable via
  append-only updates, snapshots,
  checkpoints and presence.
end note

@enduml
