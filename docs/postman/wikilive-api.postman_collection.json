{
  "info": {
    "_postman_id": "6d55d9ca-9df2-4f21-9e8b-c4b8a80f9b68",
    "name": "WikiLive API",
    "description": "Updated Postman collection for current WikiLive backend domains: auth, pages, comments, history, plugins, templates, search, ai, and MWS BFF.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{accessToken}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "pm.request.headers.upsert({ key: 'x-user-id', value: pm.environment.get('userId') || 'demo-user-1' });",
          "pm.request.headers.upsert({ key: 'x-user-name', value: pm.environment.get('userName') || 'Demo User' });",
          "const mwsToken = pm.environment.get('mwsToken');",
          "if (mwsToken) { pm.request.headers.upsert({ key: 'x-mws-token', value: mwsToken }); }"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Scenario - Core Wiki Flow",
      "description": "Happy-path scenario for wiki pages with collaboration bootstrap, access policy, comments and history.",
      "item": [
        {
          "name": "01 Health Check",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/health"
          }
        },
        {
          "name": "02 Get Wiki Tree",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/spaces/{{spaceId}}/wiki/tree"
          }
        },
        {
          "name": "03 Create Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"title\": \"Hackathon Notes {{$timestamp}}\",\n  \"icon\": \"folder\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/folders"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  if (json.folder && json.folder.id) pm.environment.set('folderId', json.folder.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "04 Create Page In Folder",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"parentNodeId\": \"{{folderId}}\",\n  \"title\": \"WikiLive Page {{$timestamp}}\",\n  \"icon\": \"doc\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/pages"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  if (json.page && json.page.id) pm.environment.set('pageId', json.page.id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "05 Get Page",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}?includeDocumentState=true"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.page && json.page.documentState && json.page.documentState.value) {",
                  "    pm.environment.set('documentState', json.page.documentState.value);",
                  "  }",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "06 Open Collaboration Session",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"client\": {\n    \"clientId\": \"postman-client-1\",\n    \"deviceId\": \"postman-device-1\",\n    \"editorVersion\": \"postman\",\n    \"userDisplayName\": \"{{userName}}\"\n  },\n  \"localDraftAvailable\": false\n}"
            },
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/collab/session"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  if (json.sessionId) pm.environment.set('collabSessionId', json.sessionId);",
                  "  if (json.websocket && json.websocket.token) pm.environment.set('collabToken', json.websocket.token);",
                  "  if (json.websocket && json.websocket.url) pm.environment.set('collabWebsocketUrl', json.websocket.url);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "07 Create Checkpoint",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"trigger\": \"manual\",\n  \"documentState\": {\n    \"encoding\": \"base64-yjs-update-v2\",\n    \"value\": \"{{documentState}}\"\n  }\n}"
            },
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/checkpoints"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if ([200,201].includes(pm.response.code)) {",
                  "  const json = pm.response.json();",
                  "  if (json.checkpointId) pm.environment.set('checkpointId', json.checkpointId);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "08 Get Page Access",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/access"
          }
        },
        {
          "name": "09 Update Page Access",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"viewAccess\": \"space_members\",\n  \"commentAccess\": \"space_members\",\n  \"editAccess\": \"space_members\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/access"
          }
        },
        {
          "name": "10 List Comments",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/comments?includeResolved=true"
          }
        },
        {
          "name": "11 List History",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/history?limit=20"
          }
        },
        {
          "name": "12 Get Backlinks",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/backlinks"
          }
        },
        {
          "name": "13 Get Outgoing Links",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/pages/{{pageId}}/outgoing-links"
          }
        },
        {
          "name": "14 Move Page To Root",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"targetParentId\": null,\n  \"position\": 0\n}"
            },
            "url": "{{baseUrl}}/api/v1/nodes/{{pageId}}/move"
          }
        }
      ]
    },
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"apiKey\": \"{{apiKey}}\",\n  \"displayName\": \"{{userName}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/auth/login"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.accessToken) pm.environment.set('accessToken', json.accessToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/refresh"
          }
        },
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/me"
          }
        },
        {
          "name": "Update Me",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"displayName\": \"Demo User Updated\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/me"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/auth/logout"
          }
        }
      ]
    },
    {
      "name": "Plugins and Templates",
      "item": [
        {
          "name": "Get Plugins Catalog",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/plugins/catalog"
          }
        },
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/templates?spaceId={{spaceId}}&scope=all&sort=newest&page=1&pageSize=20"
          }
        },
        {
          "name": "List Template Categories",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/templates/categories"
          }
        }
      ]
    },
    {
      "name": "Search and AI",
      "item": [
        {
          "name": "Search Documents",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"query\": \"архитектура\",\n  \"topK\": 5\n}"
            },
            "url": "{{baseUrl}}/api/v1/search/documents"
          }
        },
        {
          "name": "AI Definitions",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/ai/definitions"
          }
        },
        {
          "name": "AI Chat",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"question\": \"Кратко резюмируй текущую страницу\",\n  \"spaceId\": \"{{spaceId}}\",\n  \"pageId\": \"{{pageId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/ai/chat"
          }
        }
      ]
    },
    {
      "name": "MWS Tables BFF",
      "description": "Fill mwsToken and MWS IDs in environment before running.",
      "item": [
        {
          "name": "List Spaces",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/mws/spaces"
          }
        },
        {
          "name": "List Nodes",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/mws/spaces/{{mwsSpaceId}}/nodes?includeChildren=true"
          }
        },
        {
          "name": "Sync MWS Tree",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/mws/spaces/{{mwsSpaceId}}/sync-tree"
          }
        },
        {
          "name": "List Fields",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/mws/datasheets/{{mwsDatasheetId}}/fields"
          }
        },
        {
          "name": "List Views",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/mws/datasheets/{{mwsDatasheetId}}/views"
          }
        },
        {
          "name": "List Records",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/mws/datasheets/{{mwsDatasheetId}}/records?viewId={{mwsViewId}}&pageSize=10&pageNum=1&fieldKey=id&cellFormat=json"
          }
        },
        {
          "name": "Resolve Table Embed",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{mwsSpaceId}}\",\n  \"nodeId\": \"{{mwsNodeId}}\",\n  \"datasheetId\": \"{{mwsDatasheetId}}\",\n  \"viewId\": \"{{mwsViewId}}\",\n  \"displayMode\": \"table\",\n  \"pageSize\": 10,\n  \"allowInlineEdit\": true\n}"
            },
            "url": "{{baseUrl}}/api/v1/mws/table-embeds/resolve"
          }
        },
        {
          "name": "Create Or Open Table Page",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"spaceId\": \"{{spaceId}}\",\n  \"mwsSpaceId\": \"{{mwsSpaceId}}\",\n  \"nodeId\": \"{{mwsNodeId}}\",\n  \"datasheetId\": \"{{mwsDatasheetId}}\",\n  \"viewId\": \"{{mwsViewId}}\"\n}"
            },
            "url": "{{baseUrl}}/api/v1/mws/table-pages"
          }
        }
      ]
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ]
}
